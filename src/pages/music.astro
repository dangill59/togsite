---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComicBurst from '../components/ComicBurst.astro';
import Cityscape from '../components/Cityscape.astro';
import SpeedLines from '../components/SpeedLines.astro';
import { liveVideos, facebookEmbedSrc, youtubeEmbedSrc, watchUrl } from '../lib/videos';
---

<BaseLayout title="Music | Those One Guys">
  <section class="music-hero halftone">
    <SpeedLines color="#fdf5e6" opacity={0.1} />
    <Cityscape color="#1a0a05" opacity={0.25} />
    <div class="music-hero-inner">
      <div class="burst-row">
        <ComicBurst text="WHAM!" bg="#ff69b4" shape="bang" size="sm" rotate={-14} />
        <ComicBurst text="THOSE!" bg="#e8641b" shape="star" size="sm" rotate={20} />
      </div>
      <h1 class="page-hero-title comic-title">Music</h1>
      <div class="burst-row">
        <ComicBurst text="ONE!" bg="#1a8a7d" shape="pow" size="sm" rotate={-10} />
        <ComicBurst text="KERPOW!" bg="#1e90ff" shape="star" size="sm" rotate={8} />
      </div>
    </div>
  </section>

  <section class="section music-top">
    <p class="section-subtitle">Crank it up. Here's what we've been cooking.</p>

    <div class="spotify-embed comic-panel">
      <iframe
        style="border-radius: 4px;"
        src="https://open.spotify.com/embed/album/2HisOxjnnfc8p8lKSlLU9t?utm_source=generator&theme=0"
        width="100%"
        height="352"
        frameborder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>
  </section>

  {liveVideos.length > 0 && (
    <section class="section live-section">
      <div class="live-header">
        <ComicBurst text="LIVE!" bg="#e8251b" shape="bang" size="md" rotate={-12} />
        <h2 class="comic-title">Caught On Tape</h2>
        <ComicBurst text="POW!" bg="#1e90ff" shape="zap" size="sm" rotate={14} />
      </div>
      <p class="section-subtitle">Straight from the stage. Turn it up.</p>

      <div class="live-grid">
        {liveVideos.map((v) => (
          <div class="live-item comic-panel">
            <div class="live-frame">
              <button
                class="live-facade"
                type="button"
                data-embed-src={v.source.kind === 'facebook' ? facebookEmbedSrc(v.source.url, true) : youtubeEmbedSrc(v.source.id, true)}
                data-embed-title={`${v.title} — ${v.venue}`}
                aria-label={`Play ${v.title}`}
              >
                <span class="live-play" aria-hidden="true"></span>
                <span class="live-facade-text">Watch</span>
              </button>
              <noscript>
                <a class="live-fallback" href={watchUrl(v.source)} target="_blank" rel="noopener">
                  Watch “{v.title}” on {v.source.kind === 'facebook' ? 'Facebook' : 'YouTube'} →
                </a>
              </noscript>
            </div>
            <div class="live-meta">
              <h3 class="comic-title">{v.title}</h3>
              <p class="live-venue">{v.venue}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="streaming-section halftone">
    <Cityscape color="#1a0a05" opacity={0.2} />
    <SpeedLines color="#fdf5e6" opacity={0.06} />
    <div class="streaming-inner">
      <div class="streaming-bursts">
        <ComicBurst text="THOSE!" bg="#e8641b" shape="star" size="md" rotate={-8} float />
        <ComicBurst text="ONE!" bg="#1a8a7d" shape="pow" size="sm" rotate={15} float delay={200} />
      </div>
      <h2 class="comic-title">Find Us On</h2>
      <div class="streaming-links">
        <a href="https://open.spotify.com/album/2HisOxjnnfc8p8lKSlLU9t" target="_blank" rel="noopener" class="stream-badge">Spotify</a>
        <a href="#" class="stream-badge">Apple Music</a>
        <a href="#" class="stream-badge">YouTube</a>
        <a href="#" class="stream-badge">Bandcamp</a>
      </div>
      <div class="streaming-bursts">
        <ComicBurst text="GUYS!" bg="#6b2d5b" shape="jagged" size="sm" rotate={-12} float delay={300} />
        <ComicBurst text="ZAP!" bg="#ff69b4" shape="zap" size="md" rotate={10} float delay={100} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Facebook's reel player autoplays muted on load, and muted autoplay ignores
  // the iframe allow="autoplay" policy — so the only way to keep the page quiet
  // is to not create the iframe until the visitor asks for it. This also keeps
  // Facebook's tracking scripts off the page for anyone who never hits play.
  document.querySelectorAll('.live-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.parentElement;
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embedSrc ?? '';
      iframe.title = btn.dataset.embedTitle ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.setAttribute('frameborder', '0');
      frame.replaceChildren(iframe);
    }, { once: true });
  });
</script>


<style>
  .music-hero {
    position: relative;
    background: linear-gradient(135deg, var(--orange), var(--plum));
    padding: 2rem 2rem 1.75rem;
    overflow: hidden;
    text-align: center;
  }

  .music-hero-inner {
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: var(--cream);
    text-shadow: 4px 4px 0 rgba(0,0,0,0.4);
  }

  .spotify-embed {
    max-width: 700px;
    margin: 0 auto;
    background: white;
    padding: 1.5rem;
  }

  .spotify-embed iframe {
    display: block;
  }

  .streaming-section {
    background: var(--brown);
    color: var(--cream);
    text-align: center;
    padding: 4rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .streaming-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .streaming-section h2 {
    font-size: 2.5rem;
  }

  .streaming-bursts {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .streaming-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .stream-badge {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 3px solid var(--gold);
    border-radius: 4px;
    color: var(--gold);
    font-family: var(--comic);
    font-size: 1.2rem;
    letter-spacing: 3px;
    transition: background 0.3s, color 0.3s, transform 0.2s;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.4);
  }

  .stream-badge:hover {
    background: var(--gold);
    color: var(--brown);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.4);
  }

  /* === Live videos === */
  .live-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .live-header h2 {
    font-size: 2.2rem;
    color: var(--brown);
  }

  .live-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .live-item {
    background: white;
    padding: 1.25rem;
  }

  /* 16:9 box so the iframe scales instead of letterboxing at a fixed height. */
  .live-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--brown);
    border-radius: 4px;
    overflow: hidden;
  }

  /* :global is required — this iframe is created by the click handler, so it
     never gets Astro's data-astro-cid scope attribute and a scoped
     descendant selector would silently fail to match it. */
  .live-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  .live-meta {
    margin-top: 1rem;
    text-align: center;
  }

  .live-meta h3 {
    font-size: 1.3rem;
    color: var(--brown);
  }

  .live-venue {
    font-size: 0.9rem;
    color: var(--orange);
    font-family: var(--comic);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .live-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    cursor: pointer;
    border: 0;
    background: linear-gradient(135deg, var(--brown), var(--plum));
    color: var(--cream);
    transition: filter 0.2s;
  }

  .live-facade:hover { filter: brightness(1.15); }

  .live-facade:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: -3px;
  }

  /* CSS play triangle — avoids shipping an icon asset for two buttons. */
  .live-play {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 18px 0 18px 30px;
    border-color: transparent transparent transparent var(--cream);
    filter: drop-shadow(3px 3px 0 rgba(0,0,0,0.4));
    transition: transform 0.2s;
  }

  .live-facade:hover .live-play { transform: scale(1.15); }

  .live-facade-text {
    font-family: var(--comic);
    font-size: 1.1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.4);
  }

  .live-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    color: var(--cream);
    background: var(--brown);
  }

  /* The album player is the point of this page, so pull it up toward the fold.
     Scoped to this page — .section and .section-subtitle are shared globally. */
  .music-top {
    padding-top: 2.5rem;
  }

  .music-top .section-subtitle {
    margin-bottom: 1.5rem;
  }
</style>
